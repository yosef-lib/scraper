# ==== SALIN file ini menjadi .env lalu isi nilai aslinya ====
# JANGAN commit file .env ke git.

# Telegram Bot (dibuat via @BotFather). WAJIB revoke token lama karena sudah bocor.
TELEGRAM_BOT_TOKEN=
# Chat ID admin/pemilik (dapat dari @userinfobot). Untuk laporan harian.
TELEGRAM_ADMIN_CHAT_ID=

# Mata uang yang dipantau (koma-separated, id CoinGecko)
COINS=bitcoin,ethereum,solana

# Ambang sinyal: kirim alert bila perubahan 24 jam >= persen ini
ALERT_PERCENT=3.0

# Interval pengecekan (dipakai systemd timer; juga untuk jadwal internal)
CHECK_INTERVAL_MINUTES=15

# Mata uang pembanding harga
VS_CURRENCY=usd

# Lokasi database SQLite
DB_PATH=storage.sqlite3

# Harga langganan premium (info teks saja, pembayaran manual dulu)
PREMIUM_PRICE_IDR=25000
PREMIUM_DURATION_DAYS=30

# Kode aktivasi premium manual (dipakai /aktivasi <kode>)
# Buat acak, misal: openssl rand -hex 16
ADMIN_SECRET=ganti-dengan-kode-rahasia-acak
